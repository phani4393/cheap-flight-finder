{
  "name": "cheap-flight-finder",
  "version": "1.0.0",
  "description": "CLI tool to discover low-cost flights from Chicago airports to any US destination",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "cheap-flights": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "flights",
    "cheap-flights",
    "cli",
    "travel",
    "kiwi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^12.0.0",
    "cli-table3": "^0.6.3",
    "date-fns": "^3.3.0",
    "csv-stringify": "^6.4.0",
    "open": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0",
    "vitest": "^1.2.0",
    "fast-check": "^3.15.0",
    "nock": "^13.5.0",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
